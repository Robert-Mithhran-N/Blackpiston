// This is your Prisma schema file for MongoDB
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  USER
  ADMIN
  STAFF
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
  UPI
  CARD
  NETBANKING
  WALLET
}

enum RequestType {
  PRODUCT_INQUIRY
  CUSTOM_ORDER
  BULK_ORDER
  OTHER
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  RESPONDED
  COMPLETED
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ServiceType {
  MAINTENANCE
  REPAIR
  CUSTOMIZATION
  INSPECTION
  WASH
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  ORDER
  PAYMENT
  LOW_STOCK
  REQUEST
  REVIEW
  SYSTEM
  BOOKING
}

// ==================== MODELS ====================

// Embedded type for Address
type Address {
  street   String?
  city     String?
  state    String?
  pincode  String?
  country  String?
}

type SavedAddress {
  id        String   @map("_id") @db.ObjectId
  label     String
  street    String?
  city      String?
  state     String?
  pincode   String?
  country   String?
  isDefault Boolean  @default(false)
}

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String         @unique
  phone           String?
  passwordHash    String?
  role            UserRole       @default(USER)
  avatar          String?
  googleId        String?        @unique
  authProvider    String?        @default("local")
  address         Address?
  savedAddresses  SavedAddress[]
  isActive        Boolean        @default(true)
  isEmailVerified Boolean        @default(false)
  lastLogin       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  orders          Order[]
  payments        Payment[]
  requests        Request[]
  reviews         Review[]
  serviceBookings ServiceBooking[]

  @@map("users")
}

type ProductImage {
  url       String
  alt       String?
  isPrimary Boolean @default(false)
}

type ProductSpecification {
  label String
  value String
}

type ProductVariant {
  size          String?
  color         String?
  sku           String
  stockQuantity Int
  priceModifier Float @default(0)
}

type ProductDimensions {
  length Float?
  width  Float?
  height Float?
}

model Product {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String                 @unique
  description      String?
  shortDescription String?
  categoryId       String?                @db.ObjectId
  category         ProductCategory?       @relation(fields: [categoryId], references: [id])
  categorySlug     String?
  brand            String?
  price            Float
  offerPrice       Float?
  images           ProductImage[]
  specifications   ProductSpecification[]
  variants         ProductVariant[]
  stockQuantity    Int                    @default(0)
  sku              String                 @unique
  rating           Float                  @default(0)
  totalReviews     Int                    @default(0)
  tags             String[]
  isFeatured       Boolean                @default(false)
  isActive         Boolean                @default(true)
  inStock          Boolean                @default(true)
  weight           Float?
  dimensions       ProductDimensions?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  // Relations
  topOffers TopOffer[]
  inventory Inventory?
  reviews   Review[]

  @@map("products")
}

model ProductCategory {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String    @unique
  description   String?
  image         String?
  icon          String?
  parentId      String?   @db.ObjectId
  level         Int       @default(0)
  totalProducts Int       @default(0)
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  products Product[]

  @@map("product_categories")
}

type OrderProduct {
  productId   String
  name        String
  sku         String
  image       String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  variantSize String?
  variantColor String?
}

type ShippingAddress {
  name    String?
  phone   String?
  street  String?
  city    String?
  state   String?
  pincode String?
  country String?
}

type TrackingInfo {
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
}

type OrderStatusHistory {
  status    String
  timestamp DateTime
  note      String?
  updatedBy String?
}

model Order {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber        String               @unique
  userId             String               @db.ObjectId
  user               User                 @relation(fields: [userId], references: [id])
  products           OrderProduct[]
  subtotal           Float
  shippingCost       Float                @default(0)
  taxAmount          Float                @default(0)
  discountAmount     Float                @default(0)
  totalAmount        Float
  couponCode         String?
  paymentMethod      PaymentMethod        @default(COD)
  paymentStatus      PaymentStatus        @default(PENDING)
  orderStatus        OrderStatus          @default(NEW)
  shippingAddress    ShippingAddress?
  billingAddress     ShippingAddress?
  tracking           TrackingInfo?
  statusHistory      OrderStatusHistory[]
  notes              String?
  orderedAt          DateTime             @default(now())
  confirmedAt        DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Relations
  payment Payment?

  @@map("orders")
}

type GatewayResponse {
  responseCode    String?
  responseMessage String?
  rawData         Json?
}

type RefundDetails {
  refundId     String?
  refundAmount Float?
  refundReason String?
  refundedAt   DateTime?
}

model Payment {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  paymentId       String          @unique
  orderId         String          @unique @db.ObjectId
  order           Order           @relation(fields: [orderId], references: [id])
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id])
  paymentMethod   PaymentMethod
  paymentGateway  String?
  amountDue       Float
  amountReceived  Float           @default(0)
  currency        String          @default("INR")
  paymentStatus   PaymentStatus   @default(PENDING)
  transactionId   String?
  gatewayResponse GatewayResponse?
  refundDetails   RefundDetails?
  failureReason   String?
  receivedDate    DateTime?
  receivedTime    String?
  attempts        Int             @default(0)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("payments")
}

model TopOffer {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  productId          String   @db.ObjectId
  product            Product  @relation(fields: [productId], references: [id])
  title              String
  description        String?
  originalPrice      Float
  offerPrice         Float
  discountPercentage Float?
  discountType       String   @default("PERCENTAGE")
  bannerImage        String?
  badge              String?
  priority           Int      @default(0)
  validFrom          DateTime?
  validUntil         DateTime?
  isActive           Boolean  @default(true)
  usageLimit         Int?
  usedCount          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("top_offers")
}

type StockHistoryEntry {
  type        String
  quantity    Int
  reason      String?
  referenceId String?
  timestamp   DateTime
  updatedBy   String?
}

model Inventory {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  productId          String              @unique @db.ObjectId
  product            Product             @relation(fields: [productId], references: [id])
  sku                String
  availableStock     Int                 @default(0)
  reservedStock      Int                 @default(0)
  totalStock         Int                 @default(0)
  reorderLevel       Int                 @default(10)
  reorderQuantity    Int                 @default(50)
  warehouseLocation  String?
  supplierId         String?             @db.ObjectId
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  lastRestockDate    DateTime?
  lastRestockQuantity Int?
  unitCost           Float?
  stockHistory       StockHistoryEntry[]
  isLowStock         Boolean             @default(false)
  updatedAt          DateTime            @updatedAt

  @@map("inventory")
}

type BankDetails {
  bankName          String?
  accountNumber     String?
  ifscCode          String?
  accountHolderName String?
}

model Supplier {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  supplierCode       String      @unique
  supplierName       String
  contactPerson      String?
  phone              String?
  alternatePhone     String?
  email              String?
  website            String?
  address            Address?
  brandsSupplied     String[]
  categoriesSupplied String[]
  paymentTerms       String?
  leadTimeDays       Int?
  rating             Float       @default(0)
  bankDetails        BankDetails?
  gstNumber          String?
  isActive           Boolean     @default(true)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  inventory      Inventory[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

type PurchaseOrderProduct {
  productId        String
  productName      String
  sku              String
  quantity         Int
  unitCost         Float
  totalCost        Float
  receivedQuantity Int @default(0)
  damagedQuantity  Int @default(0)
}

model PurchaseOrder {
  id                   String                  @id @default(auto()) @map("_id") @db.ObjectId
  poNumber             String                  @unique
  supplierId           String                  @db.ObjectId
  supplier             Supplier                @relation(fields: [supplierId], references: [id])
  products             PurchaseOrderProduct[]
  subtotal             Float
  shippingCost         Float                   @default(0)
  taxAmount            Float                   @default(0)
  totalCost            Float
  status               String                  @default("DRAFT")
  paymentStatus        String                  @default("UNPAID")
  expectedDeliveryDate DateTime?
  orderDate            DateTime                @default(now())
  sentDate             DateTime?
  receivedDate         DateTime?
  notes                String?
  attachments          String[]
  createdBy            String?                 @db.ObjectId
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@map("purchase_orders")
}

type RequestResponse {
  message     String
  respondedBy String?
  respondedAt DateTime
}

model Request {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  requestNumber String            @unique
  userId        String            @db.ObjectId
  user          User              @relation(fields: [userId], references: [id])
  userName      String?
  userEmail     String?
  userPhone     String?
  requestType   RequestType       @default(PRODUCT_INQUIRY)
  productName   String?
  productId     String?           @db.ObjectId
  quantity      Int?
  message       String?
  attachments   String[]
  priority      Priority          @default(MEDIUM)
  requestStatus RequestStatus     @default(PENDING)
  assignedTo    String?           @db.ObjectId
  adminNotes    String?
  responses     RequestResponse[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  closedAt      DateTime?

  @@map("requests")
}

type AdminReply {
  message   String
  repliedBy String?
  repliedAt DateTime
}

model Review {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  productId          String     @db.ObjectId
  product            Product    @relation(fields: [productId], references: [id])
  userId             String     @db.ObjectId
  user               User       @relation(fields: [userId], references: [id])
  orderId            String?    @db.ObjectId
  userName           String?
  userAvatar         String?
  rating             Int
  title              String?
  comment            String?
  pros               String[]
  cons               String[]
  images             String[]
  isVerifiedPurchase Boolean    @default(false)
  helpfulCount       Int        @default(0)
  notHelpfulCount    Int        @default(0)
  isApproved         Boolean    @default(false)
  isFeatured         Boolean    @default(false)
  adminReply         AdminReply?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([productId, userId])
  @@map("reviews")
}

type BikeDetails {
  make               String?
  model              String?
  year               Int?
  registrationNumber String?
  color              String?
  engineCC           Int?
}

type BookingStatusHistory {
  status    String
  timestamp DateTime
  note      String?
  updatedBy String?
}

type ServiceFeedback {
  rating      Int?
  comment     String?
  submittedAt DateTime?
}

model ServiceBooking {
  id                String                 @id @default(auto()) @map("_id") @db.ObjectId
  bookingNumber     String                 @unique
  userId            String                 @db.ObjectId
  user              User                   @relation(fields: [userId], references: [id])
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  serviceType       ServiceType            @default(OTHER)
  serviceDescription String?
  bikeDetails       BikeDetails?
  appointmentDate   DateTime
  appointmentTime   String?
  estimatedDuration Float?
  estimatedCost     Float?
  actualCost        Float?
  status            BookingStatus          @default(PENDING)
  assignedMechanic  String?
  notes             String?
  statusHistory     BookingStatusHistory[]
  feedback          ServiceFeedback?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  completedAt       DateTime?

  @@map("service_bookings")
}

model Notification {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  type          NotificationType
  title         String
  message       String
  priority      Priority         @default(LOW)
  referenceType String?
  referenceId   String?          @db.ObjectId
  link          String?
  recipientType String           @default("ADMIN")
  recipientId   String?          @db.ObjectId
  isRead        Boolean          @default(false)
  readAt        DateTime?
  isArchived    Boolean          @default(false)
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())

  @@map("notifications")
}

type BusinessHours {
  open  String?
  close String?
}

type SocialLinks {
  facebook  String?
  instagram String?
  twitter   String?
  youtube   String?
  linkedin  String?
}

type PaymentGatewaySettings {
  enabled       Boolean @default(false)
  keyId         String?
  keySecret     String?
  webhookSecret String?
}

type CodSettings {
  enabled        Boolean @default(true)
  minOrderAmount Float?
  maxOrderAmount Float?
}

type ShippingSettings {
  freeShippingMinimum     Float?
  defaultShippingCost     Float?
  expressShippingCost     Float?
  deliveryTimeStandard    String?
  deliveryTimeExpress     String?
}

type SeoSettings {
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  ogImage         String?
  googleAnalyticsId String?
}

model Settings {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  key                String                  @unique
  siteName           String?
  siteTagline        String?
  siteLogo           String?
  favicon            String?
  contactEmail       String?
  supportEmail       String?
  contactPhone       String?
  alternatePhone     String?
  whatsappNumber     String?
  address            Address?
  socialLinks        SocialLinks?
  businessHoursMonday    BusinessHours?
  businessHoursTuesday   BusinessHours?
  businessHoursWednesday BusinessHours?
  businessHoursThursday  BusinessHours?
  businessHoursFriday    BusinessHours?
  businessHoursSaturday  BusinessHours?
  businessHoursSunday    BusinessHours?
  razorpaySettings   PaymentGatewaySettings?
  codSettings        CodSettings?
  shippingSettings   ShippingSettings?
  seoSettings        SeoSettings?
  maintenanceMode    Boolean                 @default(false)
  allowRegistration  Boolean                 @default(true)
  updatedAt          DateTime                @updatedAt
  updatedBy          String?                 @db.ObjectId

  @@map("settings")
}
